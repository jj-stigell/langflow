# Azure Deployment Environment Variables
# Copy this file to the project root as .env and fill in your values

# Required: PostgreSQL connection string
# Format: postgresql://username:password@hostname:port/database?sslmode=require
# Example: postgresql://admin:mypass123@myserver.postgres.database.azure.com:5432/langflow?sslmode=require
LANGFLOW_DATABASE_URL=

# Required: Langflow admin username
LANGFLOW_SUPERUSER=

# Required: Langflow admin password (use a strong password)
LANGFLOW_SUPERUSER_PASSWORD=

# Optional: Configuration directory (default: /home/langflow-data)
LANGFLOW_CONFIG_DIR=/home/langflow-data

# Optional: Log level (default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LANGFLOW_LOG_LEVEL=INFO

# Optional: App Service Plan SKU (default: B2)
# Options: B1 (~$13/mo), B2 (~$55/mo), B3 (~$110/mo), S1 (~$70/mo), P1v3 (~$120/mo)
APP_SERVICE_PLAN_SKU=B2

# Azure settings (will be prompted if not set)
# AZURE_ENV_NAME=dev
# AZURE_LOCATION=eastus
# AZURE_SUBSCRIPTION_ID=

# Note: The Docker image will be built from your local source code
# and pushed to Azure Container Registry automatically during deployment

# ref. https://docs.langflow.org/concepts-file-management#configure-file-storage
# S3 Storage Configuration
LANGFLOW_STORAGE_TYPE=s3
LANGFLOW_OBJECT_STORAGE_BUCKET_NAME=S3_BUCKET_NAME
# An optional folder path within the bucket where files are stored
# LANGFLOW_OBJECT_STORAGE_PREFIX=S3_BUCKET_DIRECTORY

# AWS Credentials (required for S3)
AWS_ACCESS_KEY_ID=S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=S3_ACCESS_SECRET_KEY
AWS_DEFAULT_REGION=S3_REGION
