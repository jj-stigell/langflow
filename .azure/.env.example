# Langflow Azure Deployment — Environment Variables
# Copy to .env in the project root and fill in your values.
#
# Architecture:
#   Backend  → Azure App Service (Docker container)
#   Frontend → Azure Static Web Apps on CDN
#
# ─────────────────────────────────────────────────────────────────────────────

# Required: PostgreSQL connection string
# Format: postgresql://user:password@host:5432/langflow?sslmode=require
LANGFLOW_DATABASE_URL=

# Required: Langflow superuser credentials
LANGFLOW_SUPERUSER=
LANGFLOW_SUPERUSER_PASSWORD=

# ─── S3 File Storage ────────────────────────────────────────────────────────
# ref. https://docs.langflow.org/concepts-file-management#configure-file-storage
LANGFLOW_STORAGE_TYPE=s3
LANGFLOW_OBJECT_STORAGE_BUCKET_NAME=
# Optional folder prefix inside the bucket
# LANGFLOW_OBJECT_STORAGE_PREFIX=

# AWS credentials for S3 access
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
# ────────────────────────────────────────────────────────────────────────────

# Optional — defaults shown
LANGFLOW_CONFIG_DIR=/home/langflow-data
LANGFLOW_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR | CRITICAL

# Optional — App Service plan size
# B1 ~$13/mo  |  B2 ~$55/mo (recommended)  |  S1 ~$70/mo  |  P1v3 ~$120/mo
APP_SERVICE_PLAN_SKU=B2

# Azure environment — prompted interactively if not set
# AZURE_ENV_NAME=dev
# AZURE_LOCATION=swedencentral
# AZURE_SUBSCRIPTION_ID=
